; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Swarmfront"
run/main_scene="res://scenes/Shell.tscn"
config/features=PackedStringArray("4.2")
config/icon="res://assets/branding/swarmfront_logo_1024.png"

[autoload]

OpsState="*res://scripts/ops/ops_state.gd"
ContestState="*res://scripts/state/contest_state.gd"
ProfileManager="*res://scripts/profile/profile_manager.gd"
ModerationState="*res://scripts/state/moderation_state.gd"
HoneyProgressionState="*res://scripts/state/honey_progression_state.gd"
HiveClanState="*res://scripts/state/hive_clan_state.gd"
BattlePassState="*res://scripts/state/battle_pass_state.gd"
BattlePassRuntimeAwards="*res://scripts/state/battle_pass_runtime_awards.gd"
AchievementService="*res://scripts/achievements/achievement_service.gd"
ScholasticState="*res://scripts/state/scholastic_state.gd"
RankState="*res://scripts/state/rank_state.gd"
CrucibleState="*res://scripts/state/crucible_state.gd"
RankRuntimeAwards="*res://scripts/state/rank_runtime_awards.gd"
OpsConfig="*res://scripts/state/ops_config.gd"
AnalyticsClient="*res://scripts/state/analytics_client.gd"
AdManager="*res://scripts/state/ad_manager.gd"
JukeboxRuntime="*res://scripts/state/jukebox_runtime.gd"
AppLifecycle="*res://scripts/state/app_lifecycle_state.gd"
VsHandshake="*res://scripts/state/vs_handshake_state.gd"
VsPvpRuntime="*res://scripts/state/vs_pvp_runtime.gd"
Gamebot="*res://scripts/autoload/game_boot.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="viewport"
window/stretch/aspect="keep_width"
window/handheld/orientation=1
window/size/window_width=1080
window/size/window_height=1920

[gui]

theme/custom_font="res://assets/fonts/brand/Iceland/Iceland-Regular.ttf"

[rendering]

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.168627, 0.168627, 0.168627, 1)

[swarmfront]

economy/reset_enabled=false
rank/backend_url="https://entap-identity-rank-staging.onrender.com/v1/rank"
rank/backend_token=""
rank/backend_timeout_sec=2.0
ops_config/remote_url=""
ops_config/fetch_timeout_sec=2.0
analytics/backend_url=""
analytics/enabled=false
ads/fake_ads=false
ads/show_placeholders=false
ads/dev_biodynamic_test_ads=true
ads/dev_biodynamic_image_path="res://assets/ads/test_creatives/biodynamic_laser_cleaning_banner.png"
ads/dev_biodynamic_destination_url="https://www.biodynamicusa.com"
ads/dev_biodynamic_open_url_on_tap=true
vs/backend_url="https://sf-zr2m.onrender.com/v1"
vs/backend_token=""
vs/backend_timeout_sec=6.0
vs/crash_on_contract_violation=false
arena/premium_polish_enabled=false
arena/tower_visual_scale=1.0
arena/polish_comparison_mode="settings"
arena/lane_visual_hierarchy_enabled=false
arena/dynamic_hive_shadows_enabled=true
